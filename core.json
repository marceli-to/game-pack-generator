{
  "_comment": "Machine-readable twin of the shared rules in STYLE.md. A style (styles/<name>/style.json) is merged over it.",
  "version": 1,
  "default_style": "clean",
  "blender": { "version": "5.2.4" },
  "units": { "unit_m": 1.0, "forward_blender": "-Y", "up_blender": "+Z", "rest_pose": "T" },
  "roles": ["skin", "hair", "primary", "secondary", "accent", "metal", "leather", "eyes", "dark", "special", "armor"],
  "slots": [
    "head", "hair", "headwear", "face", "torso", "arms", "hands", "legs", "feet", "accessory_back",
    "accessory_hand_l", "accessory_hand_r", "accessory_waist"
  ],
  "height_excluded_slots": ["hair", "headwear", "accessory_back", "accessory_hand_l", "accessory_hand_r", "accessory_waist"],
  "topology": { "merge_distance": 0.0001, "max_ngon": 6, "min_face_area": 1e-08 },
  "skeleton": {
    "source": "KayKit Character Animations 1.1, Animations/gltf/Rig_Medium (CC0, Kay Lousberg)",
    "armature_object": "Armature",
    "mesh_object": "Character",
    "bones": [
      { "name": "root", "parent": null, "deform": false },
      { "name": "hips", "parent": "root", "deform": true },
      { "name": "spine", "parent": "hips", "deform": true },
      { "name": "chest", "parent": "spine", "deform": true },
      { "name": "head", "parent": "chest", "deform": true },
      { "name": "headslot", "parent": "head", "deform": false, "added": true },
      { "name": "backslot", "parent": "chest", "deform": false, "added": true },
      { "name": "upperarm.l", "parent": "chest", "deform": true },
      { "name": "lowerarm.l", "parent": "upperarm.l", "deform": true },
      { "name": "wrist.l", "parent": "lowerarm.l", "deform": true },
      { "name": "hand.l", "parent": "wrist.l", "deform": true },
      { "name": "handslot.l", "parent": "hand.l", "deform": false },
      { "name": "upperarm.r", "parent": "chest", "deform": true },
      { "name": "lowerarm.r", "parent": "upperarm.r", "deform": true },
      { "name": "wrist.r", "parent": "lowerarm.r", "deform": true },
      { "name": "hand.r", "parent": "wrist.r", "deform": true },
      { "name": "handslot.r", "parent": "hand.r", "deform": false },
      { "name": "upperleg.l", "parent": "hips", "deform": true },
      { "name": "lowerleg.l", "parent": "upperleg.l", "deform": true },
      { "name": "foot.l", "parent": "lowerleg.l", "deform": true },
      { "name": "toes.l", "parent": "foot.l", "deform": true },
      { "name": "upperleg.r", "parent": "hips", "deform": true },
      { "name": "lowerleg.r", "parent": "upperleg.r", "deform": true },
      { "name": "foot.r", "parent": "lowerleg.r", "deform": true },
      { "name": "toes.r", "parent": "foot.r", "deform": true }
    ],
    "slot_bones": {
      "headwear": "headslot",
      "accessory_back": "backslot",
      "accessory_hand_l": "handslot.l",
      "accessory_hand_r": "handslot.r"
    },
    "part_bones": {
      "_comment": "bones a part of each slot may be weighted to; vertices without weights get the nearest of these at assembly (rigid, STYLE.md §9a)",
      "head": ["head"],
      "hair": ["head"],
      "headwear": ["head"],
      "face": ["head"],
      "torso": ["hips", "spine", "chest"],
      "arms": ["upperarm.l", "lowerarm.l", "upperarm.r", "lowerarm.r"],
      "hands": ["wrist.l", "hand.l", "wrist.r", "hand.r"],
      "legs": ["upperleg.l", "lowerleg.l", "upperleg.r", "lowerleg.r"],
      "feet": ["foot.l", "toes.l", "foot.r", "toes.r"],
      "accessory_back": ["chest"],
      "accessory_hand_l": ["hand.l"],
      "accessory_hand_r": ["hand.r"],
      "accessory_waist": ["hips"]
    },
    "part_blend_bones": {
      "_comment": "extra bones a part of the slot may use in explicit blended weights (P.set_weights), never as nearest-bone targets (STYLE.md §9a)",
      "torso": ["upperarm.l", "upperarm.r"],
      "hair": ["chest"]
    }
  },
  "animations": {
    "fps": 30,
    "source": "KayKit Character Animations 1.1, Animations/gltf/Rig_Medium (CC0, Kay Lousberg)",
    "root_motion": false,
    "clips": [
      { "name": "idle", "source": "Idle_A", "file": "Rig_Medium_General.glb", "loop": true, "frames": 32 },
      { "name": "walk", "source": "Walking_A", "file": "Rig_Medium_MovementBasic.glb", "loop": true, "frames": 32 },
      { "name": "run", "source": "Running_A", "file": "Rig_Medium_MovementBasic.glb", "loop": true, "frames": 24 },
      {
        "name": "jump",
        "source": "Jump_Full_Short",
        "file": "Rig_Medium_MovementBasic.glb",
        "loop": false,
        "frames": 35
      },
      {
        "name": "attack",
        "source": "Melee_1H_Attack_Chop",
        "file": "Rig_Medium_CombatMelee.glb",
        "loop": false,
        "frames": 32
      },
      { "name": "hit", "source": "Hit_A", "file": "Rig_Medium_General.glb", "loop": false, "frames": 20 },
      { "name": "die", "source": "Death_A", "file": "Rig_Medium_General.glb", "loop": false, "frames": 24 },
      { "name": "interact", "source": "Interact", "file": "Rig_Medium_General.glb", "loop": false, "frames": 39 }
    ],
    "_comment_extra": "STYLE.md §8b: opt-in per character (spec.extra_clips); range = source frames kept, hold = one source frame held for `frames`; sides = arms keyed (1H: right only); breathe = one breath per loop (deg about local X); over = arms solved on that clip's first-frame torso (crouch_*: gun level on the leaning chest)",
    "extra_clips": [
      {
        "name": "aim_1h",
        "source": "Ranged_1H_Aiming",
        "file": "Rig_Medium_CombatRanged.glb",
        "loop": true,
        "range": [12, 32],
        "arms_only": true,
        "sides": ["r"],
        "frames": 20
      },
      {
        "name": "shoot_1h",
        "source": "Ranged_1H_Shooting",
        "file": "Rig_Medium_CombatRanged.glb",
        "loop": false,
        "range": [0, 12],
        "arms_only": true,
        "sides": ["r"],
        "frames": 12
      },
      {
        "name": "aim_2h",
        "source": "Ranged_2H_Aiming",
        "file": "Rig_Medium_CombatRanged.glb",
        "loop": true,
        "range": [8, 48],
        "arms_only": true,
        "stance": {"forward": 0.85, "inward": 0.25, "down": 0.3, "left": {"along": 0.18, "out": 0.08, "down": 0.02}, "elbow": {"out": 0.25, "forward": 0.2, "down": 0.15}, "shoulder": {"forward": 0.12, "in": 0.03}},
        "frames": 40
      },
      {
        "name": "shoot_2h",
        "source": "Ranged_2H_Shooting",
        "file": "Rig_Medium_CombatRanged.glb",
        "loop": false,
        "range": [0, 8],
        "arms_only": true,
        "stance": {"forward": 0.85, "inward": 0.25, "down": 0.3, "left": {"along": 0.18, "out": 0.08, "down": 0.02}, "elbow": {"out": 0.25, "forward": 0.2, "down": 0.15}, "shoulder": {"forward": 0.12, "in": 0.03}},
        "frames": 8
      },
      {
        "name": "crouch",
        "source": "Crouching",
        "file": "Rig_Medium_MovementAdvanced.glb",
        "loop": true,
        "hold": 8,
        "arms_only": false,
        "breathe": {"spine": 1.0, "chest": 1.5, "head": -1.5},
        "frames": 64
      },
      {
        "name": "crouch_walk",
        "source": "Crouching",
        "file": "Rig_Medium_MovementAdvanced.glb",
        "loop": true,
        "arms_only": false,
        "frames": 32
      },
      {"name": "crouch_aim_1h", "source": "Ranged_1H_Aiming", "file": "Rig_Medium_CombatRanged.glb", "loop": true, "range": [12, 32], "arms_only": true, "over": "crouch", "sides": ["r"], "frames": 20},
      {"name": "crouch_shoot_1h", "source": "Ranged_1H_Shooting", "file": "Rig_Medium_CombatRanged.glb", "loop": false, "range": [0, 12], "arms_only": true, "over": "crouch", "sides": ["r"], "frames": 12},
      {"name": "crouch_aim_2h", "source": "Ranged_2H_Aiming", "file": "Rig_Medium_CombatRanged.glb", "loop": true, "range": [8, 48], "arms_only": true, "over": "crouch", "stance": {"forward": 0.85, "inward": 0.25, "down": 0.3, "left": {"along": 0.18, "out": 0.08, "down": 0.02}, "elbow": {"out": 0.25, "forward": 0.2, "down": 0.15}, "shoulder": {"forward": 0.12, "in": 0.03}}, "frames": 40},
      {"name": "crouch_shoot_2h", "source": "Ranged_2H_Shooting", "file": "Rig_Medium_CombatRanged.glb", "loop": false, "range": [0, 8], "arms_only": true, "over": "crouch", "stance": {"forward": 0.85, "inward": 0.25, "down": 0.3, "left": {"along": 0.18, "out": 0.08, "down": 0.02}, "elbow": {"out": 0.25, "forward": 0.2, "down": 0.15}, "shoulder": {"forward": 0.12, "in": 0.03}}, "frames": 8}
    ],
    "arms_only_bones": ["upperarm", "lowerarm", "wrist", "hand", "handslot"],
    "_comment_stride": "STYLE.md §8: archetypes.<name>.clip_stride re-plants walk/run feet for a ground speed; contact = how far above its lowest a foot may be and still count as planted (m)",
    "stride": { "contact": 0.03, "leg_bones": ["upperleg", "lowerleg", "foot"] }
  },
  "export": { "format": "GLB", "y_up": true, "draco": false, "texture_filter": "NEAREST", "max_validator_errors": 0 },
  "skinning": {
    "_comment": "STYLE.md §9a: robes and tabards (torso part reaching > 5 cm below the hips, with or without legs) get skirt weights",
    "skirt": { "follow": 1.0, "full_at": 0.5, "centre_width": 0.12 },
    "max_bones_per_vertex": 3,
    "upright_held_clips": ["die"],
    "upright_clearance": 0.015,
    "joint_blends": [
      { "bone": "upperarm", "parent": "chest", "axis": "out_x", "width": 0.05 },
      { "bone": "foot", "parent": "lowerleg", "axis": "down_z", "width": 0.04 },
      { "bone": "lowerleg", "parent": "upperleg", "axis": "down_z", "width": 0.04 }
    ]
  },
  "part_covers": {
    "_comment": "features a part may declare it hides (P.covers in the build script, STYLE.md §9a); validate checks them (§12)",
    "ears": "the head's islands out at the sides (centre beyond 70 % of the skull's half-width) must not be visible"
  },
  "covers_check": {
    "_comment": "validate's covered_visible rule (STYLE.md §12): a direction counts only if a cone of rays cone_deg wide gets out; warn from min_verts visible vertices",
    "cone_deg": 4,
    "min_verts": 3
  },
  "props": {
    "_comment": "STYLE.md §9b: items outside a character (weapons, thrown items, pickups); built like parts, no rig",
    "dir": "props",
    "types": {
      "weapon": { "anchors": ["grip", "muzzle"], "origin": "grip", "budget": "weapon" },
      "thrown": { "anchors": ["grip"], "origin": "grip", "budget": "weapon" },
      "pickup": { "anchors": [], "origin": "floor", "budget": "prop" },
      "world": { "anchors": [], "origin": "floor", "budget": "prop" },
      "target": { "anchors": ["hinge", "board_centre"], "pieces": ["board"], "origin": "floor", "budget": "prop" }
    },
    "origin_tolerance": 0.001,
  "split_materials": "spec.materials = {name: [roles]}: those faces get a named copy of the palette material (STYLE.md \u00a79b)",
    "views": ["item_side", "item_top", "item_front", "item_three_quarter"]
  },
  "foot_contact_tolerance": 0.02,
  "fit": {
    "_comment": "automatic fit to the reference sheet (STYLE.md §7b): width/depth scale curves per body region, scored against the sheet's outline and colour classes",
    "groups": {
      "head": {"slots": ["head", "hair", "headwear", "face"], "axis": "z"},
      "torso": {"slots": ["torso", "accessory_waist", "accessory_back"], "axis": "z"},
      "arms": {"slots": ["arms"], "axis": "x", "centre": "shoulder.l", "meets": {"end": "hands"}},
      "hands": {"slots": ["hands"], "axis": "x", "centre": "shoulder.l"},
      "legs": {"slots": ["legs"], "axis": "z", "centre": "hip.l", "meets": {"start": "feet"}},
      "feet": {"slots": ["feet"], "axis": "z", "centre": "hip.l"}
    },
    "size": 256,
    "w_silhouette": 0.4,
    "colour_merge": 14,
    "bounds": [0.75, 1.35],
    "steps": [0.08, 0.04, 0.02],
    "passes": 2,
    "smooth_penalty": 0.05,
    "arms_down_step": 3,
    "arms_down_range": [50, 85]
  },
  "pose_test": {
    "penetration_tolerance": 0.01,
    "step": 2,
    "foot_contact_clips": ["walk", "run"],
    "columns": 4,
    "tile_size": 256,
    "frame_scale": 1.1,
    "floor_margin": 0.06,
    "max_upright_tilt_deg": 30,
    "visible_cone_deg": 4,
    "visible_tolerance": 0.03
  }
}
